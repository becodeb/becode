# API key de OpenAI usada por el servicio de IA (src/lib/server/ai/client.ts):
# alimenta el bot del sitio y la generación de prompts del CRM.
OPENAI_API_KEY=

# Opcional. Modelo a usar en las respuestas de IA.
OPENAI_MODEL=gpt-4o-mini

# Conexión a PostgreSQL (Prisma). Para dev local:
#   docker run -d --name becode-pg -e POSTGRES_PASSWORD=becode \
#     -e POSTGRES_USER=becode -e POSTGRES_DB=becode -p 5434:5432 postgres:16-alpine
DATABASE_URL=postgresql://becode:becode@localhost:5434/becode

# Carpeta donde se guardan los archivos subidos por los clientes.
UPLOADS_DIR=./uploads

# Credenciales del usuario OWNER creado por `npm run db:seed`.
# OWNER_EMAIL=hola@becode.com.ar
# OWNER_PASSWORD=

# Puerto en el que escucha el servidor Node en standalone mode.
PORT=4321
