---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import HeroShowcase from '@/components/react/HeroShowcase';

export interface Props {
  herramientas: CollectionEntry<'proyectos'>[];
  recursos: CollectionEntry<'proyectos'>[];
}

const { herramientas, recursos } = Astro.props;

// Deck order: the 4 herramientas (by orden, already sorted by the caller),
// then the 3 most recent recursos.
const deckSource = [...herramientas, ...recursos.slice(0, 3)];

const showcaseProjects = await Promise.all(
  deckSource.map(async ({ id, data }) => {
    const optimized = await getImage({
      src: data.captura,
      width: 1200,
      format: 'webp',
    });
    return {
      id,
      name: data.nombre,
      category:
        data.tipo === 'herramienta' ? 'Herramienta' : (data.nivel ?? 'Recurso'),
      screenshot: optimized.src,
      url: data.url,
      resumen: data.resumen,
    };
  }),
);
---

<div
  class="hero-showcase"
  aria-label="Vistas previas de proyectos de becode"
>
  <HeroShowcase client:load projects={showcaseProjects} />
</div>

<style>
  /*
   * No absolute positioning and no min-height here: the deck sizes itself
   * from its own aspect-ratio box (set in HeroShowcase) plus the caption row
   * below, and the hero section's grid (`items-center`) centers this block
   * against the text column. An absolute slot used to push the deck above
   * the text; letting it flow in-grid keeps it aligned instead.
   */
  .hero-showcase {
    animation: hero-in 700ms 220ms both cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-showcase {
      animation: none;
    }
  }
</style>
