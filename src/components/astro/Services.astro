---
const services = [
  {
    name: 'Desarrollo web a medida',
    description:
      'Sitios y aplicaciones rápidas, accesibles y preparadas para crecer sin rehacerse cada seis meses.',
    deliverables: 'Web apps · Portales · Integraciones',
  },
  {
    name: 'Sistemas de gestión y SaaS',
    description:
      'Procesos críticos convertidos en software claro: menos trabajo repetido, más información para decidir.',
    deliverables: 'Dashboards · Roles · Automatización',
  },
  {
    name: 'Plataformas educativas',
    description:
      'Experiencias para escuelas y equipos que combinan pedagogía, operación cotidiana y tecnología confiable.',
    deliverables: 'Campus · Gamificación · Analítica',
  },
  {
    name: 'MVPs y nuevos productos',
    description:
      'De una hipótesis concreta a una primera versión que se puede probar, medir y poner frente a usuarios reales.',
    deliverables: 'Estrategia · Diseño · Desarrollo',
  },
];
---

<section id="servicios" data-scan class="section-space border-line border-t">
  <div class="shell grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow text-signal mb-5">Qué hacemos</p>
      <h2 class="section-title">La medida justa de tecnología.</h2>
      <p class="text-muted mt-7 max-w-md leading-7">
        Entramos donde el software puede cambiar una operación de verdad.
        Entendemos el problema, elegimos bien y construimos.
      </p>
    </div>
    <div class="reveal divide-line border-line divide-y border-y">
      {
        services.map((service, index) => (
          <article class="service-row grid gap-5 py-8 sm:grid-cols-[3rem_1fr] sm:py-10">
            <span class="text-signal font-mono text-sm" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-display text-2xl font-semibold sm:text-3xl">
                {service.name}
              </h3>
              <p class="text-muted mt-4 max-w-xl leading-7">
                {service.description}
              </p>
              <p class="mt-5 font-mono text-[0.68rem] font-semibold uppercase">
                {service.deliverables}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .service-row {
    position: relative;
    transition:
      transform 280ms cubic-bezier(0.2, 0.75, 0.25, 1),
      padding-left 280ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .service-row::before {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 0;
    width: 0.2rem;
    background: var(--color-signal);
    content: '';
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 280ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .service-row h3 {
    transition: color 220ms ease;
  }

  .service-row:hover {
    padding-left: 0.85rem;
  }

  .service-row:hover::before {
    transform: scaleY(1);
  }

  .service-row:hover h3 {
    color: var(--color-signal);
  }
</style>
