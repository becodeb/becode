---
import { Image } from 'astro:assets';
import logoBe from '@/assets/logo-be.png';
---

<header
  class="border-line/80 bg-paper/90 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-md"
>
  <nav
    class="shell flex h-16 items-center justify-between"
    aria-label="Navegación principal"
  >
    <a href="#inicio" class="header-brand" aria-label="becode, inicio">
      <span class="brand-symbol-crop" aria-hidden="true">
        <Image
          src={logoBe}
          alt=""
          width={64}
          height={64}
          densities={[1, 2]}
          format="webp"
          quality={82}
          class="brand-symbol-image"
        />
      </span>
      <span class="header-brand-text" aria-hidden="true"
        >be<span class="text-signal">/</span>code</span
      >
    </a>
    <div class="hidden items-center gap-7 text-sm font-semibold md:flex">
      <a class="hover:text-signal transition-colors" href="#proyectos"
        >Proyectos</a
      >
      <a class="hover:text-signal transition-colors" href="#servicios"
        >Servicios</a
      >
      <a class="hover:text-signal transition-colors" href="#proceso">Proceso</a>
      <a class="hover:text-signal transition-colors" href="#equipo">Equipo</a>
      <a
        class="bg-signal text-surface hover:bg-signal-dark rounded-[var(--radius-ui)] px-4 py-2.5 transition-colors active:translate-y-px"
        href="#contacto">Hablemos</a
      >
    </div>
    <details class="mobile-navigation md:hidden">
      <summary
        class="mobile-menu-toggle border-ink grid h-11 w-11 cursor-pointer list-none place-items-center rounded-[var(--radius-ui)] border marker:hidden"
        title="Abrir navegación"
      >
        <span class="sr-only">Abrir navegación</span>
        <span class="menu-icon" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </summary>
      <div
        class="mobile-menu border-line bg-surface shadow-window fixed inset-x-0 top-16 border-t border-b"
      >
        <div class="shell py-5">
          <p class="eyebrow text-signal mb-3">Navegación</p>
          <div class="mobile-menu-links border-line border-t">
            <a href="#proyectos"><span>01</span>Proyectos</a>
            <a href="#servicios"><span>02</span>Servicios</a>
            <a href="#proceso"><span>03</span>Proceso</a>
            <a href="#equipo"><span>04</span>Equipo</a>
          </div>
          <a
            class="bg-ink text-surface mt-5 flex items-center justify-between rounded-[var(--radius-ui)] px-5 py-4 font-bold"
            href="#contacto"
          >
            Hablemos <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </details>
  </nav>
</header>

<style>
  .header-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .brand-symbol-crop {
    position: relative;
    width: 2.75rem;
    height: 2rem;
    overflow: hidden;
    flex: 0 0 auto;
  }

  .brand-symbol-image {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4rem;
    max-width: none;
    height: 4rem;
    mix-blend-mode: multiply;
    transform: translate(-50%, -50%);
  }

  .mobile-navigation[open]::before {
    position: fixed;
    z-index: -1;
    inset: 4rem 0 0;
    background: rgb(21 21 21 / 0.28);
    content: '';
    backdrop-filter: blur(3px);
  }

  .mobile-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-icon {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 0.9rem;
  }

  .menu-icon i {
    position: absolute;
    right: 0;
    left: 0;
    height: 2px;
    background: currentColor;
    transition:
      top 220ms ease,
      transform 220ms ease;
  }

  .menu-icon i:first-child {
    top: 0.15rem;
  }

  .menu-icon i:last-child {
    top: 0.65rem;
  }

  .mobile-navigation[open] .menu-icon i:first-child {
    top: 0.42rem;
    transform: rotate(45deg);
  }

  .mobile-navigation[open] .menu-icon i:last-child {
    top: 0.42rem;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    animation: menu-enter 240ms both cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .mobile-menu-links a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 8vw, 2.25rem);
    font-weight: 600;
    line-height: 1;
  }

  .mobile-menu-links a span {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @keyframes menu-enter {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
  }

  .header-brand-text {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
  }

  .header-brand-text :global(.brand-caret) {
    display: inline-block;
    width: 2px;
    height: 0.95em;
    margin-left: 2px;
    background: var(--color-ink);
    vertical-align: -0.1em;
    animation: caret-blink 850ms steps(2, start) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  const brandText = document.querySelector<HTMLElement>('.header-brand-text');

  // The fixed "be/" prefix, then words that cycle to tell what becode does.
  const brandPrefix: Array<{ char: string; accent?: boolean }> = [
    { char: 'b' },
    { char: 'e' },
    { char: '/', accent: true },
  ];
  // One random word from the pool is shown, then it lands on the brand.
  const brandWordPool = [
    'clear',
    'smart',
    'simple',
    'bold',
    'sharp',
    'real',
    'fast',
    'fluid',
    'ready',
    'custom',
    'solid',
    'useful',
  ];
  let lastBrandWord = '';

  const pickBrandWord = () => {
    const options = brandWordPool.filter((word) => word !== lastBrandWord);
    const word =
      options[Math.floor(Math.random() * options.length)] ?? 'clear';
    lastBrandWord = word;
    return word;
  };

  const TYPE_MIN = 45; // per-letter typing spread (human-ish)
  const TYPE_MAX = 95;
  const ERASE_INTERVAL = 70; // mechanical backspace
  const WORD_HOLD = 1400; // how long an intermediate word rests before erasing
  const WORD_GAP = 260; // pause on empty word before the next one

  const reducedMotionQuery = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  );

  const caret = document.createElement('i');
  caret.className = 'brand-caret';

  const wordLetters: HTMLElement[] = []; // letters after the prefix (mutable word)
  let prefixTyped = false;
  let runToken = 0; // bump to cancel any in-flight sequence
  let running = false;

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  const typeDelay = () =>
    TYPE_MIN + Math.floor(Math.random() * (TYPE_MAX - TYPE_MIN));

  const addLetter = (char: string, accent: boolean, track: boolean) => {
    if (!brandText) return;
    const letter = document.createElement('span');
    if (accent) letter.className = 'text-signal';
    letter.textContent = char;
    caret.before(letter);
    if (track) wordLetters.push(letter);
  };

  // Runs an endless type/hold/erase word cycle until its token is cancelled.
  const runBrandCycle = async () => {
    if (!brandText || running) return;
    running = true;
    const token = ++runToken;

    if (!prefixTyped) {
      // Wipe any static/left-over content so we type onto a clean slate.
      brandText.textContent = '';
      wordLetters.length = 0;
    }
    brandText.append(caret);
    brandText.style.opacity = '1';

    if (!prefixTyped) {
      await sleep(450);
      for (const step of brandPrefix) {
        if (token !== runToken) return;
        addLetter(step.char, step.accent ?? false, false);
        await sleep(step.char === '/' ? 300 : typeDelay());
      }
      prefixTyped = true;
    }

    // A random word first, then the brand itself as the resting state.
    const sequence = [pickBrandWord(), 'code'];
    for (let index = 0; index < sequence.length; index++) {
      if (token !== runToken) return;
      const word = sequence[index] ?? '';
      const isLast = index === sequence.length - 1;
      await sleep(340); // beat after the slash / previous word
      for (const char of word) {
        if (token !== runToken) return;
        addLetter(char, false, true);
        await sleep(typeDelay());
      }
      if (token !== runToken) return;

      // The last word is the brand: it stays, the caret fades out, done.
      if (isLast) {
        await sleep(1500);
        if (token !== runToken) return;
        caret.remove();
        return;
      }

      await sleep(WORD_HOLD);
      while (wordLetters.length > 0) {
        if (token !== runToken) return;
        wordLetters.pop()?.remove();
        await sleep(ERASE_INTERVAL);
      }
      await sleep(WORD_GAP);
    }
  };

  // Erase everything (word + prefix) and stop, e.g. when back at the top.
  const hideBrand = async () => {
    if (!brandText || !running) return;
    const token = ++runToken;
    running = false;
    brandText.append(caret);
    while (brandText.querySelector('span')) {
      if (token !== runToken) return;
      const last = brandText.querySelector('span:last-of-type');
      last?.remove();
      wordLetters.length = 0;
      await sleep(ERASE_INTERVAL);
    }
    prefixTyped = false;
    await sleep(300);
    if (token !== runToken) return;
    caret.remove();
    brandText.style.opacity = '0';
  };

  const onBrandScroll = () => {
    if (!brandText) return;
    const pastThreshold = window.scrollY > 40;

    if (reducedMotionQuery.matches) {
      brandText.textContent = 'be';
      const slash = document.createElement('span');
      slash.className = 'text-signal';
      slash.textContent = '/';
      brandText.append(slash, document.createTextNode('code'));
      brandText.style.opacity = pastThreshold ? '1' : '0';
      return;
    }

    if (pastThreshold) {
      if (!running) runBrandCycle();
    } else if (running) {
      hideBrand();
    }
  };
  window.addEventListener('scroll', onBrandScroll, { passive: true });
  onBrandScroll();

  const mobileNavigation =
    document.querySelector<HTMLDetailsElement>('header details');

  mobileNavigation?.addEventListener('toggle', () => {
    document.documentElement.classList.toggle(
      'menu-open',
      mobileNavigation.open,
    );
    const label = mobileNavigation.querySelector('.sr-only');
    if (label) {
      label.textContent = mobileNavigation.open
        ? 'Cerrar navegación'
        : 'Abrir navegación';
    }
  });

  mobileNavigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNavigation.open = false;
    });
  });

  document.addEventListener('click', (event) => {
    if (
      mobileNavigation?.open &&
      event.target instanceof Node &&
      !mobileNavigation.contains(event.target)
    ) {
      mobileNavigation.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNavigation?.open) {
      mobileNavigation.open = false;
      mobileNavigation.querySelector('summary')?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && mobileNavigation?.open) {
      mobileNavigation.open = false;
    }
  });
</script>
