---
import type { CollectionEntry } from 'astro:content';
import ProjectGrid from '@/components/react/ProjectGrid';

export interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const serializedProjects = projects.map(({ id, data }) => ({ id, ...data }));
---

<section
  id="proyectos"
  data-scan
  class="section-space border-line bg-surface border-t"
>
  <div class="shell">
    <div class="reveal mb-14 max-w-4xl">
      <p class="eyebrow text-signal mb-5">Trabajo real, en uso</p>
      <h2 class="section-title">Productos que ya hacen su parte.</h2>
      <p class="text-muted mt-7 max-w-2xl text-base leading-7 sm:text-lg">
        Diseñamos sistemas para operar, aprender, vender y decidir. Acá hay una
        selección de lo que construimos.
      </p>
    </div>
    <ProjectGrid projects={serializedProjects} client:visible />
  </div>
</section>

<style is:global>
  #proyectos {
    overflow: clip;
    padding-top: clamp(4.5rem, 8vw, 8rem);
  }

  .filter-strip {
    scrollbar-width: none;
  }

  .filter-strip::-webkit-scrollbar {
    display: none;
  }

  .featured-projects {
    display: grid;
    gap: clamp(7rem, 15vw, 13rem);
  }

  .project-card--spotlight {
    position: relative;
    border-top: 1px solid var(--color-line);
    padding-top: clamp(2rem, 4vw, 4rem);
  }

  .project-card--spotlight::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-signal);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
  }

  .project-copy {
    margin-top: 1.25rem;
  }

  .project-status {
    font-size: 0.65rem;
  }

  .project-name {
    line-height: 0.96;
  }

  .project-card--spotlight .project-name {
    font-size: clamp(2.75rem, 7vw, 5rem);
  }

  .project-card--compact .project-name {
    font-size: 1.5rem;
  }

  .project-description {
    max-width: 46ch;
    font-size: 0.9rem;
  }

  .project-card--spotlight .project-description {
    font-size: 1rem;
    line-height: 1.75;
  }

  .project-stack {
    font-size: 0.66rem;
  }

  .project-category {
    color: var(--color-muted);
  }

  .project-arrow {
    width: 2.65rem;
    height: 2.65rem;
  }

  .project-card--compact .project-arrow {
    width: 2.4rem;
    height: 2.4rem;
  }

  .project-visual {
    position: relative;
    isolation: isolate;
    transition:
      border-color 200ms ease,
      box-shadow 300ms ease;
  }

  .project-curtain {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: end;
    justify-content: end;
    background: var(--color-surface);
    padding: 1rem;
    color: var(--color-signal-dark);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: right;
  }

  .project-card--spotlight:nth-child(even) .project-curtain {
    transform-origin: left;
  }

  .project-frame {
    overflow: hidden;
  }

  .project-frame > * {
    transition: transform 500ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .project-card:hover .project-visual {
    border-color: var(--color-ink);
    box-shadow: 0 1.25rem 3rem rgb(67 48 28 / 0.13);
  }

  .project-card:hover .project-frame > * {
    transform: scale(1.018);
  }

  .compact-projects {
    margin-top: clamp(8rem, 15vw, 14rem);
  }

  .project-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .placeholder-toolbar {
    display: grid;
    grid-template-columns: 1fr auto auto;
    height: 2.75rem;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
    padding: 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .placeholder-toolbar span:last-child {
    margin-left: 0.75rem;
    color: var(--color-signal-dark);
  }

  .placeholder-logo {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
  }

  .placeholder-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    height: calc(100% - 2.75rem);
    gap: 1rem;
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }

  .placeholder-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
  }

  .placeholder-copy span {
    color: var(--color-signal-dark);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
  }

  .placeholder-copy strong {
    margin: 0.3rem 0 1rem;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 3.25rem);
    line-height: 0.95;
    text-overflow: ellipsis;
  }

  .project-card--spotlight .placeholder-copy strong {
    font-size: clamp(2.25rem, 5vw, 4.75rem);
  }

  .project-card--compact .placeholder-copy strong {
    overflow-wrap: anywhere;
    font-size: clamp(1.3rem, 2.25vw, 2.35rem);
    text-overflow: clip;
  }

  .placeholder-copy i {
    width: 80%;
    height: 0.3rem;
    margin-top: 0.4rem;
    background: var(--color-line);
  }

  .placeholder-copy i:last-child {
    width: 52%;
  }

  .placeholder-panel {
    position: relative;
    display: grid;
    align-content: center;
    gap: 0.5rem;
  }

  .placeholder-panel div {
    height: 2.4rem;
    border: 1px solid var(--color-ink);
    border-radius: 0.2rem;
    background: var(--color-surface);
  }

  .placeholder-panel div:nth-child(2) {
    background: var(--color-ink);
    transform: translateX(-0.7rem);
  }

  .project-placeholder--0 .placeholder-panel div:last-child {
    display: none;
  }

  .project-placeholder--1 .placeholder-content {
    grid-template-columns: 0.8fr 1.2fr;
  }

  .project-placeholder--1 .placeholder-panel {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
  }

  .project-placeholder--1 .placeholder-panel div {
    height: auto;
  }

  .project-placeholder--1 .placeholder-panel div:nth-child(2) {
    background: var(--color-signal);
    transform: none;
  }

  .project-placeholder--1 .placeholder-panel div:last-child {
    grid-column: 1 / -1;
    background: var(--color-ink);
  }

  .project-placeholder--2 .placeholder-content {
    display: block;
  }

  .project-placeholder--2 .placeholder-copy {
    height: 55%;
  }

  .project-placeholder--2 .placeholder-copy i {
    display: none;
  }

  .project-placeholder--2 .placeholder-panel {
    display: flex;
    height: 45%;
    align-items: end;
    gap: 0.35rem;
  }

  .project-placeholder--2 .placeholder-panel div {
    width: 25%;
    height: 42%;
    background: var(--color-ink);
  }

  .project-placeholder--2 .placeholder-panel div:nth-child(2) {
    height: 86%;
    background: var(--color-signal);
    transform: none;
  }

  .project-placeholder--2 .placeholder-panel div:nth-child(3) {
    height: 64%;
  }

  .project-placeholder--2 .placeholder-panel div:nth-child(4) {
    height: 100%;
    background: var(--color-surface);
  }

  .project-placeholder--3 .placeholder-content {
    grid-template-columns: 1fr 1.15fr;
  }

  .project-placeholder--3 .placeholder-panel {
    gap: 0.4rem;
    padding: 0.75rem;
    border: 1px solid var(--color-ink);
    background: var(--color-surface);
  }

  .project-placeholder--3 .placeholder-panel div {
    width: 72%;
    height: 0.45rem;
    border: 0;
    border-radius: 0;
    background: var(--color-line);
  }

  .project-placeholder--3 .placeholder-panel div:nth-child(2) {
    width: 42%;
    background: var(--color-signal);
    transform: none;
  }

  .project-placeholder--3 .placeholder-panel div:nth-child(3) {
    width: 88%;
    background: var(--color-ink);
  }

  .project-placeholder--3 .placeholder-panel div:last-child {
    width: 58%;
  }

  @media (min-width: 40rem) {
    #proyectos {
      padding-top: var(--spacing-section);
    }
  }

  @media (min-width: 64rem) {
    .featured-projects {
      gap: clamp(10rem, 18vh, 14rem);
    }

    .project-card--spotlight {
      display: grid;
      min-height: min(52rem, calc(100dvh - 5rem));
      grid-template-columns: minmax(0, 1.75fr) minmax(17rem, 0.55fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 4.5rem);
      padding-bottom: clamp(2rem, 4vw, 4rem);
    }

    .project-card--spotlight:nth-child(even) {
      grid-template-columns: minmax(17rem, 0.55fr) minmax(0, 1.75fr);
    }

    .project-card--spotlight:nth-child(even) .project-visual {
      grid-column: 2;
      grid-row: 1;
    }

    .project-card--spotlight:nth-child(even) .project-copy {
      grid-column: 1;
      grid-row: 1;
    }

    .project-card--spotlight .project-frame {
      height: clamp(30rem, 68vh, 46rem);
      aspect-ratio: auto;
    }

    .project-card--spotlight .project-copy {
      margin-top: 0;
    }

    .project-card--spotlight .project-name {
      font-size: clamp(3rem, 4.4vw, 5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-frame,
    .project-copy {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .project-curtain {
      display: none;
    }
  }

  @supports (animation-timeline: view()) {
    .project-card--spotlight::before {
      animation: project-line linear both;
      animation-range: entry 10% cover 55%;
      animation-timeline: view();
    }
  }

  @keyframes project-line {
    to {
      transform: scaleX(1);
    }
  }
</style>
