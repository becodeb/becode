      padding: 0.75rem;
      font-size: 0.59rem;
    }
    .terminal-command {
      gap: 0.25rem;
      font-size: 0.48rem;
    }
    .product-window {
      bottom: 1rem;
      width: 122%;
      scale: 0.78;
      transform-origin: right bottom;
    }
    .window-body {
      grid-template-columns: 4.4rem 1fr;
