  }

  .compiler-spec {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 16rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-ui);
    background: var(--color-ink);
    padding: 1.1rem;
    color: var(--color-surface);
    box-shadow: var(--shadow-window);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .compiler-spec p {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    opacity: 0;
    animation: spec-in 450ms both;
  }

  .compiler-spec p:last-child {
    border: 0;
  }

  .compiler-spec p:nth-child(1) {
    animation-delay: 600ms;
  }
  .compiler-spec p:nth-child(2) {
    animation-delay: 760ms;
  }
  .compiler-spec p:nth-child(3) {
    animation-delay: 920ms;
  }
  .compiler-spec p:nth-child(4) {
    animation-delay: 1080ms;
  }
  .compiler-key {
    color: var(--color-dim);
  }

  .compiler-value {
    color: var(--color-surface);
    transition:
      opacity 120ms ease,
      transform 120ms ease;
  }

  .compiler-value.is-updating {
    opacity: 0.2;
    transform: translateX(0.35rem);
  }

  .compiler-spec strong.compiler-value {
    color: var(--color-signal);
  }

  .terminal-command {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.45rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: var(--color-dim);
    font-size: 0.62rem;
    white-space: nowrap;
  }

  .terminal-command span {
    color: var(--color-signal);
  }

  .terminal-command i {
    width: 0.45rem;
    height: 0.85rem;
    background: var(--color-surface);
    animation: terminal-caret 800ms steps(1) infinite;
  }

  .product-window {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 1.5rem;
    width: 91%;
    overflow: hidden;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-ui);
