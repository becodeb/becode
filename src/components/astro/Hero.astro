    }
    .dash-heading .mock-button {
      padding: 0.5rem;
      font-size: 0.48rem;
    }
    .metric-row {
      gap: 0.35rem;
      margin-top: 1rem;
    }
    .metric-row article {
      padding: 0.5rem;
    }
    .metric-row strong {
      font-size: 0.9rem;
    }
    .metric-row span {
      font-size: 0.45rem;
    }
    .activity {
      padding: 0.5rem;
    }
    .activity-row {
      gap: 0.3rem;
      font-size: 0.48rem;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('#inicio');
  const terminal = hero?.querySelector<HTMLElement>('.compiler-spec');
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  const terminalStates = [
    {
      product: 'campus',
      users: '4 roles',
      flow: 'asistencia',
      status: 'compilando',
    },
    {
      product: 'inventario',
      users: '1.248 activos',
      flow: 'préstamos',
      status: 'sincronizando',
    },
    {
      product: 'horarios',
      users: '37 sedes',
      flow: 'optimización',
      status: 'validando',
    },
    {
      product: 'check-in',
      users: '842 hoy',
      flow: 'accesos',
      status: 'desplegado',
    },
  ] as const;

  let terminalStateIndex = 0;
  let terminalTimer: number | undefined;

  const cycleTerminal = () => {
    terminalStateIndex = (terminalStateIndex + 1) % terminalStates.length;
    const nextState = terminalStates[terminalStateIndex];
    if (!nextState) return;

    for (const [key, value] of Object.entries(nextState)) {
      const field = terminal?.querySelector<HTMLElement>(
        `[data-compiler-field="${key}"]`,
      );
      if (!field) continue;
      field.classList.add('is-updating');
      window.setTimeout(() => {
        field.textContent = value;
        field.classList.remove('is-updating');
      }, 120);
    }
  };

  if (terminal && !reducedMotion) {
    const terminalObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting && terminalTimer === undefined) {
          terminalTimer = window.setInterval(cycleTerminal, 2600);
        } else if (!entry?.isIntersecting && terminalTimer !== undefined) {
          window.clearInterval(terminalTimer);
          terminalTimer = undefined;
        }
      },
      { threshold: 0.2 },
    );
    terminalObserver.observe(terminal);
  }
</script>
