---
import type { CollectionEntry } from 'astro:content';
import HeroShowcase from '@/components/react/HeroShowcase';

export interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const showcaseProjects = projects.flatMap(({ id, data }) =>
  data.screenshot
    ? [
        {
          id,
          name: data.name,
          category: data.category,
          screenshot: data.screenshot,
        },
      ]
    : [],
);
---

<section
  id="inicio"
  class="relative flex min-h-[calc(100dvh-2.5rem)] items-center overflow-hidden pt-20 pb-2 sm:pb-12"
>
  <div
    class="shell grid items-center gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16"
  >
    <div class="hero-copy relative z-10 -mt-10 sm:-mt-16">
      <p
        class="hero-wordmark font-display mb-10 text-4xl font-bold sm:mb-14 sm:text-5xl"
      >
        be<span class="text-signal">/</span>code
      </p>
      <h1 class="display-title">Software que hace avanzar.</h1>
      <p
        class="text-muted mt-5 max-w-lg text-base leading-7 sm:mt-7 sm:text-lg"
      >
        Productos web y sistemas de gestión pensados, diseñados y programados a
        medida.
      </p>
      <div class="mt-7 flex flex-wrap gap-3 sm:mt-9">
        <a
          href="#contacto"
          class="bg-signal text-surface hover:bg-signal-dark rounded-[var(--radius-ui)] px-6 py-3.5 font-bold transition-colors active:translate-y-px"
        >
          Hablemos <span aria-hidden="true">↗</span>
        </a>
        <a
          href="#proyectos"
          class="border-ink hover:bg-ink hover:text-surface rounded-[var(--radius-ui)] border px-6 py-3.5 font-bold transition-colors active:translate-y-px"
        >
          Ver proyectos
        </a>
      </div>
    </div>

    <div class="compiler" aria-label="Vistas previas de proyectos de becode">
      <div class="showcase-slot">
        <HeroShowcase client:load projects={showcaseProjects} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-copy {
    animation: hero-in 700ms 100ms both cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .compiler {
    position: relative;
    min-height: 35rem;
    animation: hero-in 800ms 260ms both cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .showcase-slot {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 1.5rem;
    width: 91%;
    opacity: 0;
    transform: translateY(1.5rem) scale(0.97);
    animation: product-in 600ms 520ms forwards cubic-bezier(0.23, 1, 0.32, 1);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
  @keyframes product-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 63.99rem) {
    .compiler {
      min-height: 34rem;
    }
    .showcase-slot {
      width: 92%;
    }
  }

  @media (max-width: 37.5rem) {
    .compiler {
      min-height: 20rem;
    }
    .showcase-slot {
      bottom: 1rem;
      width: 100%;
    }
  }
</style>
