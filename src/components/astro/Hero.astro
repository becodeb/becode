    }
  }

  @keyframes terminal-drift {
    from {
      translate: 0 1.5rem;
    }
    to {
      translate: 0 -2rem;
    }
  }

  @supports (animation-timeline: view()) {
    .compiler-spec {
      animation: terminal-drift linear both;
      animation-range: cover 0% cover 100%;
      animation-timeline: view();
    }
  }

  @media (max-width: 63.99rem) {
    .compiler {
      min-height: 34rem;
