    box-shadow: var(--shadow-window);
    opacity: 0;
    transform: translateY(1.5rem) scale(0.97);
    animation: product-in 700ms 1250ms forwards cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .window-bar {
