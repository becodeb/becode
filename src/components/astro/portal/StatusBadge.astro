---
import { STATUS_META, type ProjectStatusValue } from '@/lib/project-status';

interface Props {
  status: string;
}

const meta = STATUS_META[Astro.props.status as ProjectStatusValue] ?? {
  label: Astro.props.status,
  dot: 'bg-dim',
  badge: 'bg-line text-muted border-line',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold',
    meta.badge,
  ]}
>
  <span class:list={['h-1.5 w-1.5 rounded-full', meta.dot]} aria-hidden="true"
  ></span>
  {meta.label}
</span>
