---
import ChatBot from '@/components/react/ChatBot';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const defaultCanonical = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
).href;
const { title, description, canonical = defaultCanonical } = Astro.props;
const socialImage = new URL('/og.svg', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="becode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      document.documentElement.classList.add('motion-ready');
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="boot-screen" aria-hidden="true">
      <div class="boot-console">
        <span>BECODE SYSTEM</span>
        <code>compile ./product</code>
        <strong>READY</strong>
      </div>
      <i></i>
    </div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a
      href="#contenido"
      class="bg-ink text-surface fixed top-3 left-3 z-[100] -translate-y-20 rounded-[var(--radius-ui)] px-4 py-3 text-sm font-bold transition-transform focus:translate-y-0"
    >
      Ir al contenido
    </a>
    <slot />
    <ChatBot client:idle />
    <script is:inline>
      const revealElements = Array.from(document.querySelectorAll('.reveal'));

      const reveal = (element) => {
        element.classList.add('is-visible');
        observer.unobserve(element);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              reveal(entry.target);
            }
          }
        },
        { threshold: 0.01, rootMargin: '0px 0px -8% 0px' },
      );

      const revealPassedElements = () => {
        const revealLine = window.innerHeight * 0.92;
        for (const element of revealElements) {
          if (
            !element.classList.contains('is-visible') &&
            element.getBoundingClientRect().top <= revealLine
          ) {
            reveal(element);
          }
        }
      };

      revealElements.forEach((element) => observer.observe(element));
      requestAnimationFrame(revealPassedElements);

      const layoutObserver = new ResizeObserver(() => {
        requestAnimationFrame(revealPassedElements);
      });
      layoutObserver.observe(document.body);

      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const counterElements = Array.from(
        document.querySelectorAll('[data-count]'),
      );

      const setCounter = (element, value) => {
        const suffix = element.dataset.suffix ?? '';
        element.textContent = `${Math.round(value).toLocaleString('es-AR')}${suffix}`;
      };

      const animateCounter = (element) => {
        const target = Number(element.dataset.count ?? 0);
        const currentValue = Number(
          (element.textContent ?? '').replace(/[^0-9.-]/g, ''),
        );
        const startValue = Number.isFinite(currentValue)
          ? currentValue
          : target;
        if (reducedMotion) {
          setCounter(element, target);
          return;
        }

        const duration = 900;
        const startTime = performance.now();

        const tick = (time) => {
          const progress = Math.min((time - startTime) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          setCounter(element, startValue + (target - startValue) * eased);
          if (progress < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      };

      const counterObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              counterObserver.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.5 },
      );

      counterElements.forEach((element) => counterObserver.observe(element));
    </script>
  </body>
</html>
