---
import RegisterForm from '@/components/react/auth/RegisterForm';
import PortalLayout from '@/layouts/PortalLayout.astro';

export const prerender = false;
---

<PortalLayout title="Crear cuenta" variant="auth">
  <div class="portal-enter mx-auto max-w-md">
    <div class="mb-8 text-center">
      <h1 class="font-display text-3xl font-bold tracking-tight">
        Comenzá tu proyecto
      </h1>
      <p class="text-muted mt-2 text-sm">
        Creá tu cuenta, contanos qué necesitás en unos minutos y nosotros nos
        encargamos del resto.
      </p>
    </div>
    <div class="portal-card p-6 sm:p-8">
      <RegisterForm client:load />
    </div>
    <p class="text-muted mt-6 text-center text-sm">
      ¿Ya tenés cuenta?
      <a
        href="/login"
        class="text-ink hover:text-signal font-semibold underline underline-offset-2"
      >
        Iniciá sesión
      </a>
    </p>
  </div>
</PortalLayout>
