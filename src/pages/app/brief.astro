---
import BriefWizard from '@/components/react/portal/BriefWizard';
import PortalLayout from '@/layouts/PortalLayout.astro';
import { prisma } from '@/lib/server/db';

export const prerender = false;

const user = Astro.locals.user!;
if (user.role === 'OWNER') return Astro.redirect('/admin');

const project = await prisma.project.findFirst({
  where: { clientId: user.id },
  orderBy: { createdAt: 'desc' },
  include: { brief: true },
});

// Con el proyecto ya aprobado, las respuestas no se editan más.
if (project && project.status !== 'PENDIENTE') return Astro.redirect('/app');

const brief = project?.brief;
const mapValue = (value: string, aliases: Record<string, string>) =>
  aliases[value] ?? value;
const mapValues = (value: unknown, aliases: Record<string, string>) =>
  Array.isArray(value)
    ? value.map((item) => mapValue(String(item), aliases))
    : [];

const industryAliases: Record<string, string> = {
  Salud: 'Salud y bienestar',
  Fitness: 'Deportes y entrenamiento',
  Inmobiliaria: 'Inmobiliaria y construcción',
  Abogados: 'Servicios legales',
  Restaurante: 'Gastronomía',
};
const colorAliases: Record<string, string> = { Morado: 'Violeta' };
const feelingAliases: Record<string, string> = {
  Profesional: 'Autoridad',
  Lujo: 'Exclusividad',
  Velocidad: 'Energía',
  Juvenil: 'Diversión',
  Elegante: 'Autoridad',
};
const sectionAliases: Record<string, string> = {
  Nosotros: 'Quiénes somos',
  Servicios: 'Qué ofrecemos',
  Productos: 'Productos o servicios',
  FAQ: 'Preguntas frecuentes',
  Blog: 'Blog o novedades',
  Turnos: 'Turnos o reservas',
  Dashboard: 'Panel personal',
  Login: 'Ingreso y registro',
  Registro: 'Ingreso y registro',
  'Panel Admin': 'Panel de administración',
};
const initial = brief
  ? {
      siteType: brief.siteType,
      industry: mapValue(brief.industry, industryAliases),
      projectSummary: brief.projectSummary,
      mainGoal: brief.mainGoal,
      targetAudience: brief.targetAudience,
      primaryAction: brief.primaryAction,
      successMetric: brief.successMetric,
      aesthetics: brief.aesthetics as string[],
      colors: mapValues(brief.colors, colorAliases),
      feelings: mapValues(brief.feelings, feelingAliases),
      avoidances: brief.avoidances ?? '',
      sections: [...new Set(mapValues(brief.sections, sectionAliases))],
      features: brief.features as string[],
      contentStatus: brief.contentStatus,
      hasContent: brief.contentStatus === 'Ya tenemos textos e imágenes listos',
      contentManagement: brief.contentManagement,
      language: brief.language,
      hasLogo: brief.hasLogo,
      hasBrand: brief.hasBrand,
      hasDomain: brief.hasDomain,
      existingSiteUrl: brief.existingSiteUrl ?? '',
      budgetRange: brief.budgetRange,
      urgency: brief.urgency,
      referenceUrls: brief.referenceUrls as string[],
      referenceNotes: brief.referenceNotes ?? '',
      materialLink: brief.materialLink ?? '',
      contactPreference: brief.contactPreference,
      phone: brief.phone ?? '',
      comment: brief.comment ?? '',
    }
  : undefined;
---

<PortalLayout title={brief ? 'Editar brief' : 'Brief del proyecto'}>
  <div class="portal-enter mx-auto max-w-3xl">
    <header class="mb-8">
      <p class="text-signal font-mono text-xs tracking-widest uppercase">
        Brief inteligente
      </p>
      <h1 class="font-display mt-2 text-3xl font-bold tracking-tight">
        {brief ? 'Ajustá tus respuestas' : 'Contanos tu proyecto'}
      </h1>
      <p class="text-muted mt-2 text-sm">
        Son 4 etapas cortas. Preguntamos sólo lo que cambia de verdad el
        proyecto y nosotros resolvemos el resto.
      </p>
    </header>

    <div class="portal-card p-6 sm:p-8">
      <BriefWizard client:load initial={initial} />
    </div>
  </div>
</PortalLayout>
