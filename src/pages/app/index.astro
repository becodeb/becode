---
import Checklist from '@/components/astro/portal/Checklist.astro';
import StatusBadge from '@/components/astro/portal/StatusBadge.astro';
import PortalLayout from '@/layouts/PortalLayout.astro';
import {
  PROJECT_STATUSES,
  STATUS_META,
  formatDate,
  formatDateTime,
  type ProjectStatusValue,
} from '@/lib/project-status';
import { getClientProject } from '@/lib/server/projects/queries';

export const prerender = false;

const user = Astro.locals.user!;
const project = await getClientProject(user);
if (user.role === 'OWNER') return Astro.redirect('/admin');

const statusIndex = project ? PROJECT_STATUSES.indexOf(project.status) : -1;
const progress = project
  ? Math.max(8, Math.round((statusIndex / (PROJECT_STATUSES.length - 1)) * 100))
  : 0;
const latestEvent = project?.timelineEvents[0];

const statusCopy: Record<ProjectStatusValue, string> = {
  PENDIENTE:
    'Estamos revisando tus respuestas y el material para definir el alcance.',
  APROBADO: 'El proyecto está confirmado y estamos organizando el trabajo.',
  DISENO:
    'Estamos definiendo la experiencia, las pantallas y el estilo visual.',
  DESARROLLO: 'Estamos construyendo las pantallas y funciones del proyecto.',
  TESTING: 'Estamos revisando detalles y probando que todo funcione bien.',
  DEPLOY: 'Estamos preparando la publicación y la configuración final.',
  FINALIZADO: 'El proyecto está publicado y listo para usar.',
};
---

<PortalLayout title="Mi proyecto">
  <div class="portal-enter space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-muted text-sm">
          {project?.company.name ?? 'Bienvenido'}
        </p>
        <h1 class="font-display text-3xl font-bold tracking-tight">
          Hola, {user.firstName}
        </h1>
      </div>
      {project && <StatusBadge status={project.status} />}
    </header>

    {
      !project ? (
        <section class="portal-card px-6 py-14 text-center sm:px-10">
          <p class="text-signal font-mono text-xs tracking-widest uppercase">
            Primer paso
          </p>
          <h2 class="font-display mt-3 text-2xl font-bold">
            Contanos qué querés construir
          </h2>
          <p class="text-muted mx-auto mt-3 max-w-md text-sm leading-6">
            Son cuatro etapas cortas. Al terminar vas a poder subir logo,
            imágenes y material del proyecto.
          </p>
          <a
            href="/app/brief"
            class="bg-signal text-surface hover:bg-signal-dark mt-6 inline-block rounded-[var(--radius-ui)] px-6 py-3 text-sm font-bold transition-colors"
          >
            Empezar →
          </a>
        </section>
      ) : (
        <>
          <section
            class="portal-card p-6 sm:p-7"
            aria-label="Estado del proyecto"
          >
            <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
              <div>
                <p class="text-signal font-mono text-[0.65rem] tracking-widest uppercase">
                  Ahora · {STATUS_META[project.status].label}
                </p>
                <h2 class="font-display mt-2 text-2xl font-bold">
                  {project.title}
                </h2>
                <p class="text-muted mt-2 max-w-2xl text-sm leading-6">
                  {statusCopy[project.status]}
                </p>
              </div>
              {project.status === 'PENDIENTE' && (
                <a
                  href="/app/brief"
                  class="border-line hover:border-ink rounded-[var(--radius-ui)] border px-4 py-2 text-sm font-semibold transition-colors"
                >
                  Editar brief
                </a>
              )}
            </div>
            <div class="mt-6 flex items-center gap-3">
              <div
                class="bg-line h-2 flex-1 overflow-hidden rounded-full"
                role="progressbar"
                aria-label="Etapa general del proyecto"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow={progress}
              >
                <div
                  class="bg-signal h-full rounded-full transition-all duration-500"
                  style={`width: ${progress}%`}
                />
              </div>
              <span class="text-muted font-mono text-xs">{progress}%</span>
            </div>
            <div class="text-dim mt-3 flex flex-wrap justify-between gap-2 text-xs">
              <span>Iniciado el {formatDate(project.createdAt)}</span>
              <span>{STATUS_META[project.status].label}</span>
            </div>
          </section>

          <div class="grid gap-6 lg:grid-cols-[1.6fr_0.8fr]">
            <section class="portal-card p-6" aria-label="Plan y progreso">
              <div class="mb-5">
                <p class="text-signal font-mono text-[0.65rem] tracking-widest uppercase">
                  Plan del proyecto
                </p>
                <h2 class="font-display mt-1 text-xl font-bold">
                  Qué hicimos y qué sigue
                </h2>
              </div>
              <Checklist items={project.checklistItems} />
            </section>

            <aside class="portal-card p-6" aria-label="Próximos pasos">
              <p class="text-signal font-mono text-[0.65rem] tracking-widest uppercase">
                Tu próximo paso
              </p>
              <h2 class="font-display mt-2 text-xl font-bold">
                {project.files.length === 0
                  ? 'Compartí el material que tengas'
                  : 'Ya tenemos tu material'}
              </h2>
              <p class="text-muted mt-2 text-sm leading-6">
                {project.files.length === 0
                  ? 'Logo, imágenes, textos o documentos nos ayudan a avanzar con menos idas y vueltas.'
                  : `Subiste ${project.files.length} ${project.files.length === 1 ? 'archivo' : 'archivos'}. Podés agregar más cuando quieras.`}
              </p>
              <a
                href="/app/archivos"
                class="bg-ink text-surface hover:bg-signal mt-5 block rounded-[var(--radius-ui)] px-4 py-2.5 text-center text-sm font-bold transition-colors"
              >
                {project.files.length === 0
                  ? 'Subir archivos →'
                  : 'Ver archivos →'}
              </a>

              <div class="border-line mt-6 border-t pt-5">
                <p class="text-muted text-xs font-semibold uppercase">
                  ¿Necesitás hablar con nosotros?
                </p>
                <a
                  href="/app/mensajes"
                  class="hover:text-signal mt-2 inline-block text-sm font-semibold"
                >
                  Ir a mensajes →
                </a>
              </div>
            </aside>
          </div>

          {latestEvent && (
            <section class="border-line flex flex-wrap items-center justify-between gap-3 border-t pt-5">
              <div>
                <p class="text-muted text-xs font-semibold uppercase">
                  Última actualización
                </p>
                <p class="mt-1 text-sm font-semibold">{latestEvent.title}</p>
                {latestEvent.description && (
                  <p class="text-muted mt-0.5 text-xs">
                    {latestEvent.description}
                  </p>
                )}
              </div>
              <time class="text-dim font-mono text-xs">
                {formatDateTime(latestEvent.createdAt)}
              </time>
            </section>
          )}
        </>
      )
    }
  </div>
</PortalLayout>
