---
import StatusBadge from '@/components/astro/portal/StatusBadge.astro';
import PortalLayout from '@/layouts/PortalLayout.astro';
import type { Prisma } from '@/generated/prisma/client';
import {
  PRIORITY_LABELS,
  PROJECT_STATUSES,
  STATUS_META,
  formatDate,
  type ProjectStatusValue,
} from '@/lib/project-status';
import { urgencyLabel } from '@/lib/brief-options';
import { prisma } from '@/lib/server/db';

export const prerender = false;

const params = Astro.url.searchParams;
const search = params.get('q')?.trim() ?? '';
const statusFilter = params.get('estado') ?? '';
const tagFilter = params.get('etiqueta') ?? '';
const priorityFilter = params.get('prioridad') ?? '';

const where: Prisma.ProjectWhereInput = {
  ...(PROJECT_STATUSES.includes(statusFilter as ProjectStatusValue) && {
    status: statusFilter as ProjectStatusValue,
  }),
  ...(tagFilter && { tags: { some: { id: tagFilter } } }),
  ...(['BAJA', 'MEDIA', 'ALTA', 'URGENTE'].includes(priorityFilter) && {
    priority: priorityFilter as 'BAJA' | 'MEDIA' | 'ALTA' | 'URGENTE',
  }),
  ...(search && {
    OR: [
      { title: { contains: search, mode: 'insensitive' as const } },
      { company: { name: { contains: search, mode: 'insensitive' as const } } },
      {
        client: {
          firstName: { contains: search, mode: 'insensitive' as const },
        },
      },
      {
        client: {
          lastName: { contains: search, mode: 'insensitive' as const },
        },
      },
      { client: { email: { contains: search, mode: 'insensitive' as const } } },
    ],
  }),
};

const [projects, tags] = await Promise.all([
  prisma.project.findMany({
    where,
    orderBy: { createdAt: 'desc' },
    include: { company: true, client: true, brief: true, tags: true },
    take: 60,
  }),
  prisma.tag.findMany({ orderBy: { name: 'asc' } }),
]);

const selectClass =
  'border-line bg-surface text-ink rounded-[var(--radius-ui)] border px-3 py-2 text-sm focus:border-signal focus:outline-none';
---

<PortalLayout title="Clientes" variant="admin">
  <div class="portal-enter space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-bold tracking-tight">Clientes</h1>
        <p class="text-muted mt-1 text-sm">{projects.length} resultados</p>
      </div>
    </header>

    <form
      method="get"
      class="portal-card flex flex-wrap items-center gap-3 p-4"
    >
      <input
        type="search"
        name="q"
        value={search}
        placeholder="Buscar por empresa, contacto o proyecto…"
        aria-label="Buscar"
        class="border-line bg-paper focus:border-signal min-w-0 flex-1 rounded-[var(--radius-ui)] border px-3.5 py-2 text-sm focus:outline-none"
      />
      <select name="estado" aria-label="Filtrar por estado" class={selectClass}>
        <option value="">Todos los estados</option>
        {
          PROJECT_STATUSES.map((status) => (
            <option value={status} selected={status === statusFilter}>
              {STATUS_META[status].label}
            </option>
          ))
        }
      </select>
      <select
        name="prioridad"
        aria-label="Filtrar por prioridad"
        class={selectClass}
      >
        <option value="">Toda prioridad</option>
        {
          Object.entries(PRIORITY_LABELS).map(([value, label]) => (
            <option value={value} selected={value === priorityFilter}>
              {label}
            </option>
          ))
        }
      </select>
      <select
        name="etiqueta"
        aria-label="Filtrar por etiqueta"
        class={selectClass}
      >
        <option value="">Toda etiqueta</option>
        {
          tags.map((tag) => (
            <option value={tag.id} selected={tag.id === tagFilter}>
              {tag.name}
            </option>
          ))
        }
      </select>
      <button
        type="submit"
        class="bg-ink text-surface hover:bg-signal rounded-[var(--radius-ui)] px-4 py-2 text-sm font-bold transition-colors"
      >
        Filtrar
      </button>
    </form>

    {
      projects.length === 0 ? (
        <div class="portal-card px-6 py-16 text-center">
          <p class="font-display text-lg font-bold">Sin resultados</p>
          <p class="text-muted mt-2 text-sm">
            Probá con otros filtros, o esperá a que llegue el próximo cliente.
          </p>
        </div>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <li>
              <article class="portal-card flex h-full flex-col p-5 transition-transform hover:-translate-y-0.5">
                <div class="flex items-start justify-between gap-2">
                  <h2 class="font-display text-lg font-bold">
                    {project.company.name}
                  </h2>
                  <StatusBadge status={project.status} />
                </div>
                <p class="text-muted mt-1 text-sm">
                  {project.client.firstName} {project.client.lastName} ·{' '}
                  {project.client.email}
                </p>
                <p class="mt-3 text-sm font-medium">{project.title}</p>
                <div class="text-dim mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[0.65rem]">
                  <span>{formatDate(project.createdAt)}</span>
                  {project.brief && (
                    <span>Urgencia: {urgencyLabel(project.brief.urgency)}</span>
                  )}
                  <span>Prioridad: {PRIORITY_LABELS[project.priority]}</span>
                </div>
                {project.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {project.tags.map((tag) => (
                      <span
                        class="rounded-full border px-2 py-0.5 text-[0.65rem] font-semibold"
                        style={`border-color: ${tag.color}55; color: ${tag.color}`}
                      >
                        {tag.name}
                      </span>
                    ))}
                  </div>
                )}
                <div class="mt-auto pt-4">
                  <a
                    href={`/admin/clientes/${project.id}`}
                    class="border-line hover:border-ink block rounded-[var(--radius-ui)] border px-4 py-2 text-center text-sm font-semibold transition-colors"
                  >
                    Ver cliente
                  </a>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</PortalLayout>
