---
import StatusBadge from '@/components/astro/portal/StatusBadge.astro';
import PortalLayout from '@/layouts/PortalLayout.astro';
import {
  PROJECT_STATUSES,
  STATUS_META,
  formatDateTime,
} from '@/lib/project-status';
import { prisma } from '@/lib/server/db';

export const prerender = false;

const startOfMonth = new Date();
startOfMonth.setDate(1);
startOfMonth.setHours(0, 0, 0, 0);

const [
  statusGroups,
  monthProjects,
  revenue,
  delivered,
  recentActivity,
  recentClients,
] = await Promise.all([
  prisma.project.groupBy({ by: ['status'], _count: { _all: true } }),
  prisma.project.count({ where: { createdAt: { gte: startOfMonth } } }),
  prisma.project.aggregate({
    _sum: { quote: true },
    where: { status: 'FINALIZADO' },
  }),
  prisma.project.findMany({
    where: { deliveredAt: { not: null }, approvedAt: { not: null } },
    select: { approvedAt: true, deliveredAt: true },
  }),
  prisma.timelineEvent.findMany({
    orderBy: { createdAt: 'desc' },
    take: 10,
    include: { project: { include: { company: true } } },
  }),
  prisma.project.findMany({
    where: { status: 'PENDIENTE' },
    orderBy: { createdAt: 'desc' },
    take: 5,
    include: { company: true, client: true },
  }),
]);

const countByStatus = Object.fromEntries(
  statusGroups.map((group) => [group.status, group._count._all]),
);
const count = (status: string) => countByStatus[status] ?? 0;
const total = statusGroups.reduce((sum, group) => sum + group._count._all, 0);
const active =
  count('APROBADO') +
  count('DISENO') +
  count('DESARROLLO') +
  count('TESTING') +
  count('DEPLOY');

const avgDays = delivered.length
  ? Math.round(
      delivered.reduce(
        (sum, p) =>
          sum +
          (p.deliveredAt!.getTime() - p.approvedAt!.getTime()) / 86_400_000,
        0,
      ) / delivered.length,
    )
  : null;

const revenueTotal = revenue._sum.quote ? Number(revenue._sum.quote) : 0;

const metrics = [
  { label: 'Clientes activos', value: active },
  { label: 'Pendientes', value: count('PENDIENTE') },
  { label: 'En desarrollo', value: count('DESARROLLO') },
  { label: 'Finalizados', value: count('FINALIZADO') },
  {
    label: 'Ingresos (finalizados)',
    value: `US$ ${revenueTotal.toLocaleString('es-AR')}`,
  },
  { label: 'Proyectos del mes', value: monthProjects },
  {
    label: 'Tiempo promedio',
    value: avgDays === null ? '—' : `${avgDays} días`,
  },
];

const maxCount = Math.max(
  1,
  ...PROJECT_STATUSES.map((status) => count(status)),
);
---

<PortalLayout title="CRM" variant="admin">
  <div class="portal-enter space-y-6">
    <header>
      <h1 class="font-display text-3xl font-bold tracking-tight">Dashboard</h1>
      <p class="text-muted mt-1 text-sm">
        {
          total === 0
            ? 'Sin proyectos todavía.'
            : `${total} proyectos en total.`
        }
      </p>
    </header>

    <section
      class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4"
      aria-label="Indicadores"
    >
      {
        metrics.map((metric) => (
          <div class="portal-card p-4">
            <p class="text-muted text-xs font-semibold tracking-wide uppercase">
              {metric.label}
            </p>
            <p class="font-display mt-2 text-2xl font-bold">{metric.value}</p>
          </div>
        ))
      }
    </section>

    <div class="grid gap-6 lg:grid-cols-5">
      <section
        class="portal-card p-6 lg:col-span-2"
        aria-label="Proyectos por estado"
      >
        <h2 class="font-display mb-5 text-base font-bold">
          Proyectos por estado
        </h2>
        <ul class="space-y-3">
          {
            PROJECT_STATUSES.map((status) => (
              <li>
                <div class="mb-1 flex items-center justify-between text-xs">
                  <span class="font-semibold">{STATUS_META[status].label}</span>
                  <span class="text-muted font-mono">{count(status)}</span>
                </div>
                <div class="bg-line h-2 overflow-hidden rounded-full">
                  <div
                    class:list={[
                      'h-full rounded-full',
                      STATUS_META[status].dot,
                    ]}
                    style={`width: ${(count(status) / maxCount) * 100}%`}
                  />
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="portal-card p-6 lg:col-span-3"
        aria-label="Actividad reciente"
      >
        <h2 class="font-display mb-5 text-base font-bold">
          Actividad reciente
        </h2>
        {
          recentActivity.length === 0 ? (
            <p class="text-muted text-sm">
              La actividad de los proyectos va a aparecer acá.
            </p>
          ) : (
            <ul class="divide-line divide-y">
              {recentActivity.map((event) => (
                <li class="flex items-center justify-between gap-3 py-2.5 first:pt-0 last:pb-0">
                  <div class="min-w-0">
                    <p class="truncate text-sm font-medium">{event.title}</p>
                    <p class="text-muted truncate text-xs">
                      {event.project.company.name} · {event.project.title}
                    </p>
                  </div>
                  <span class="text-dim shrink-0 font-mono text-[0.65rem]">
                    {formatDateTime(event.createdAt)}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>

    {
      recentClients.length > 0 && (
        <section class="portal-card p-6" aria-label="Pendientes de aprobación">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="font-display text-base font-bold">
              Esperando aprobación
            </h2>
            <a
              href="/admin/clientes?estado=PENDIENTE"
              class="text-signal text-sm font-semibold hover:underline"
            >
              Ver todos →
            </a>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {recentClients.map((project) => (
              <li>
                <a
                  href={`/admin/clientes/${project.id}`}
                  class="portal-card block p-4 transition-transform hover:-translate-y-0.5"
                >
                  <div class="flex items-start justify-between gap-2">
                    <p class="font-semibold">{project.company.name}</p>
                    <StatusBadge status={project.status} />
                  </div>
                  <p class="text-muted mt-1 text-sm">
                    {project.client.firstName} {project.client.lastName}
                  </p>
                  <p class="text-dim mt-2 font-mono text-[0.65rem]">
                    {formatDateTime(project.createdAt)}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</PortalLayout>
