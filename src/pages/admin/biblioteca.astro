---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { formatDate } from '@/lib/project-status';
import { prisma } from '@/lib/server/db';

export const prerender = false;

const [templates, references] = await Promise.all([
  prisma.promptTemplate.findMany({ orderBy: { createdAt: 'desc' } }),
  prisma.referenceItem.findMany({ orderBy: { createdAt: 'desc' } }),
]);
---

<PortalLayout title="Biblioteca" variant="admin">
  <div class="portal-enter space-y-6">
    <header>
      <h1 class="font-display text-3xl font-bold tracking-tight">
        Biblioteca de conocimiento
      </h1>
      <p class="text-muted mt-1 text-sm">
        Prompts exitosos y referencias visuales para reutilizar en próximos
        proyectos.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="portal-card p-6" aria-label="Plantillas de prompts">
        <h2 class="font-display mb-4 text-base font-bold">
          Plantillas de prompts ({templates.length})
        </h2>
        {
          templates.length === 0 ? (
            <p class="text-muted text-sm">
              Guardá prompts desde la vista de un cliente con “Guardar como
              plantilla”.
            </p>
          ) : (
            <ul class="space-y-3">
              {templates.map((template) => (
                <li class="border-line bg-paper rounded-[var(--radius-ui)] border">
                  <details>
                    <summary class="cursor-pointer px-4 py-3">
                      <span class="text-sm font-semibold">
                        {template.title}
                      </span>
                      <span class="text-dim ml-2 font-mono text-[0.65rem]">
                        {template.category} · {formatDate(template.createdAt)}
                      </span>
                    </summary>
                    <div class="border-line border-t px-4 py-3">
                      <pre class="font-body max-h-72 overflow-y-auto text-sm leading-relaxed whitespace-pre-wrap">
                        {template.content}
                      </pre>
                      <button
                        type="button"
                        data-delete-template={template.id}
                        class="text-muted hover:text-signal mt-2 text-xs underline underline-offset-2"
                      >
                        Eliminar plantilla
                      </button>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="portal-card p-6" aria-label="Referencias visuales">
        <h2 class="font-display mb-4 text-base font-bold">
          Referencias visuales ({references.length})
        </h2>

        <form
          id="reference-form"
          class="border-line mb-5 space-y-2 border-b pb-5"
        >
          <input
            type="text"
            name="title"
            required
            maxlength="160"
            placeholder="Nombre (ej: Hero de Linear)"
            aria-label="Nombre de la referencia"
            class="border-line bg-paper focus:border-signal w-full rounded-[var(--radius-ui)] border px-3.5 py-2 text-sm focus:outline-none"
          />
          <input
            type="url"
            name="url"
            required
            maxlength="500"
            placeholder="https://…"
            aria-label="URL de la referencia"
            class="border-line bg-paper focus:border-signal w-full rounded-[var(--radius-ui)] border px-3.5 py-2 text-sm focus:outline-none"
          />
          <input
            type="text"
            name="notes"
            maxlength="1000"
            placeholder="Notas (opcional)"
            aria-label="Notas"
            class="border-line bg-paper focus:border-signal w-full rounded-[var(--radius-ui)] border px-3.5 py-2 text-sm focus:outline-none"
          />
          <button
            type="submit"
            class="bg-ink text-surface hover:bg-signal w-full rounded-[var(--radius-ui)] px-4 py-2 text-sm font-bold transition-colors"
          >
            Agregar referencia
          </button>
        </form>

        {
          references.length === 0 ? (
            <p class="text-muted text-sm">
              Sumá sitios y componentes que te inspiren para asociarlos a
              futuros proyectos.
            </p>
          ) : (
            <ul class="space-y-3">
              {references.map((reference) => (
                <li class="border-line bg-paper flex items-start justify-between gap-3 rounded-[var(--radius-ui)] border px-4 py-3">
                  <div class="min-w-0">
                    <p class="text-sm font-semibold">{reference.title}</p>
                    <a
                      href={reference.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-signal font-mono text-xs break-all hover:underline"
                    >
                      {reference.url}
                    </a>
                    {reference.notes && (
                      <p class="text-muted mt-1 text-xs">{reference.notes}</p>
                    )}
                  </div>
                  <button
                    type="button"
                    data-delete-reference={reference.id}
                    aria-label={`Eliminar ${reference.title}`}
                    class="text-muted hover:text-signal shrink-0 text-xs"
                  >
                    ✕
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </div>

  <script>
    const form = document.getElementById(
      'reference-form',
    ) as HTMLFormElement | null;
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      await fetch('/api/admin/references', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: data.get('title'),
          url: data.get('url'),
          notes: String(data.get('notes') ?? '').trim() || undefined,
        }),
      });
      window.location.reload();
    });

    const bindDelete = (
      selector: string,
      endpoint: string,
      attribute: string,
    ) => {
      document
        .querySelectorAll<HTMLButtonElement>(selector)
        .forEach((button) => {
          button.addEventListener('click', async () => {
            button.disabled = true;
            await fetch(endpoint, {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: button.getAttribute(attribute) }),
            });
            window.location.reload();
          });
        });
    };

    bindDelete(
      '[data-delete-template]',
      '/api/admin/templates',
      'data-delete-template',
    );
    bindDelete(
      '[data-delete-reference]',
      '/api/admin/references',
      'data-delete-reference',
    );
  </script>
</PortalLayout>
